.env
.env.*
# ...but the committed contract is the whole point of .env.example.
!.env.example
node_modules/
.venv/
.pytest_cache/
__pycache__/
.next/
dist/
coverage/
.DS_Store

# OFAC full-list snapshots are 27MB+ and re-fetchable; their hashes are recorded in
# data/PROVENANCE.md and data/archive/index.json, which is what actually proves provenance.
data/SDN.XML
data/archive/sdn-*.xml

# Delta files are ~130KB and ARE the replay evidence for the release leg -- keep them.
# (no ignore rule for data/archive/delta-*.xml, by design)

# Local archiver log and heartbeat (launchd stopgap; operational state, not a deliverable).
# The heartbeat is rewritten on every poll, so committing it would dirty the tree every 6h.
data/archive/archiver.log
data/archive/last-poll.json

# Tooling
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local generated measurement output (regenerated by make challenge-set / bench).
# The committed copies under data/ are the published figures; these are scratch.
/tmp/

# Browser toolchain output for the site/ E2E + performance gates (package.json).
# The product is Python; none of this ships.
playwright-report/
test-results/
.lighthouseci/

# Runtime lock held by the 6h archiver poll so two runs cannot open the same
# re-screen. Machine-local state, never a repository artifact.
data/archive/rescreen.lock

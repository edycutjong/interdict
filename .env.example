# Interdict — environment
#
# Copy to .env and fill in. .env is gitignored; this file is the committed contract.
# Only GEMINI_API_KEY is required for the judged capability. Everything else has a
# working default, and every default is the one `make reproduce` runs with.

# ─── required for the adjudication and interdiction legs ────────────────────────
# Get from: https://aistudio.google.com/apikey  (free tier, no billing account)
# run_rescreen.py REFUSES to start without this rather than falling back to a test
# double — a reproduce command that quietly disables the thing being judged is worse
# than one that fails loudly.
GEMINI_API_KEY=

# Get from: the same page. Accepted as an alias if GEMINI_API_KEY is unset.
# GOOGLE_API_KEY=

# ─── optional: the cloud evidence plane ─────────────────────────────────────────
# Without these the run is identical except that nothing is mirrored off-machine.
# Get from: https://console.cloud.google.com/firestore — create a project, then a
# service account with roles/datastore.user and download its JSON key.
# INTERDICT_FIRESTORE_PROJECT=your-gcp-project-id
# INTERDICT_FIRESTORE_DATABASE=(default)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ─── local stack (defaults match ops/docker-compose.yml — `make up`) ────────────
# INTERDICT_DSN=postgresql://interdict:interdict@localhost:5433/interdict
# INTERDICT_YENTE_URL=http://localhost:8000

# ─── tuning ─────────────────────────────────────────────────────────────────────
# The pinned default. Overriding it is recorded on every decision: the `model`
# column names whichever adjudicator produced the verdict, so a substitution can
# never be mistaken for the product path.
# INTERDICT_MODEL=gemini-3.5-flash-lite

# Evidence console port (python -m interdict.console)
# PORT=8080

# ─── the unattended trigger (ops/com.interdict.ofac-archiver.plist) ─────────────
# Set by the launchd job so an archived publication can open a re-screen on its own.
# INTERDICT_RESCREEN_ON_NEW=1
# INTERDICT_ARCHIVER_INVOKER=launchd
